# Docker image підсистеми кіберзахисту.
CYBERSECURITY_IMAGE=rostyslavkrotenko/cybersecurity-smartenergy:latest
# Обов'язково замініть випадковим значенням у локальному файлі .env.
GATEWAY_CONTROL_TOKEN=replace-with-a-random-64-character-token
CYBERSECURITY_API_PORT=6049
CYBERSECURITY_IOT_GATEWAY_PORT=6066
CYBERSECURITY_BMS_GATEWAY_PORT=6065
GATEWAY_RATE_PER_SECOND=25
GATEWAY_BURST_CAPACITY=50
GATEWAY_COMMAND_RATE_PER_MINUTE=12
GATEWAY_VIOLATION_THRESHOLD=10
GATEWAY_VIOLATION_WINDOW_SEC=30
GATEWAY_BLOCK_TTL_SEC=120
GATEWAY_UPSTREAM_TIMEOUT_SEC=3
GATEWAY_CIRCUIT_FAILURE_THRESHOLD=5
GATEWAY_CIRCUIT_RECOVERY_TIMEOUT_SEC=15
GATEWAY_STALE_CACHE_TTL_SEC=30
GATEWAY_CONTROL_TIMEOUT_SECONDS=5
CONTROL_POLL_INTERVAL_SEC=0.5
COLLECTOR_HTTP_TIMEOUT_SEC=2
COLLECTOR_HTTP_POLL_INTERVAL_SEC=10
CYBERSECURITY_ADAPTER_TIMEOUT_SEC=2
CYBERSECURITY_CORS_ORIGINS=http://localhost:5173,http://0.0.0.0:5173,http://77.47.192.6:5173
